# ==============================================================================
# ENGLISH TEACHER HOMEWORK PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment (production / development)
APP_ENV=production
DEBUG=false
TIMEZONE=Asia/Tashkent
APP_NAME="English Teacher Platform"

# Application URLs
BASE_URL=https://api.yourdomain.com
BACKEND_URL=https://api.yourdomain.com
WEBAPP_URL=https://app.yourdomain.com/app
ADMIN_PANEL_URL=https://app.yourdomain.com/admin

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=YOUR_PRODUCTION_BOT_TOKEN_HERE
ADMIN_TELEGRAM_IDS=1073079396,6896779142

# Database Configuration (SQLite for local, PostgreSQL for cloud deployment)
DATABASE_URL=sqlite+aiosqlite:///./platform.db
# DATABASE_URL=postgresql+asyncpg://postgres_user:postgres_password@localhost:5432/platform_db

# Redis Configuration (Optional)
REDIS_URL=redis://localhost:6379/0

# Security / JWT (Use a high-entropy 64-character secret key in production)
JWT_SECRET=YOUR_SECURE_RANDOM_JWT_SECRET_KEY_HERE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# CORS Origins (JSON array of allowed origins)
BACKEND_CORS_ORIGINS=["https://app.yourdomain.com", "https://web.telegram.org"]
